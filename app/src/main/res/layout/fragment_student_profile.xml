<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootStudentProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kiosk_bg">

    <!-- Top Header Bar with HUST Branding & End Session -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_hust_header"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_hust_emblem"
            android:contentDescription="HUST Emblem" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CỔNG DỊCH VỤ SINH VIÊN"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ĐẠI HỌC BÁCH KHOA HÀ NỘI"
                android:textColor="@color/hust_gold"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <Button
            android:id="@+id/btnEndSessionTop"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="#40FFFFFF"
            android:textColor="@color/white"
            android:text="🚪  Kết thúc phiên"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Main Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="800dp"
            android:orientation="vertical">

            <!-- Student Profile Summary Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_white_rounded"
                android:orientation="horizontal"
                android:padding="20dp"
                android:elevation="2dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_student_avatar"
                    android:contentDescription="Avatar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="20dp">

                    <TextView
                        android:id="@+id/tvStudentName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nguyễn Văn An"
                        android:textColor="@color/hust_red"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="4dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvStudentId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/badge_status_bg"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="MSSV: 20231001"
                            android:textColor="@color/status_info"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStudentClass"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Lớp: IT1-01 • Khoa: Công nghệ Thông tin"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStudentEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email: an.nv231001@sis.hust.edu.vn"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:paddingTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Timeout Notice Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#E8EDF5"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱"
                    android:textSize="14sp"
                    android:paddingEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Phiên làm việc tự động kết thúc sau 90 giây không tương tác (Chạm để gia hạn)."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Services Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHỌN DỊCH VỤ KIOSK TỰ PHỤC VỤ:"
                android:textColor="@color/hust_red_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingTop="20dp"
                android:paddingBottom="12dp" />

            <!-- Service 1: Xem Bảng Điểm -->
            <LinearLayout
                android:id="@+id/cardBtnViewGrades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_service_item"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:elevation="1dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_grades"
                    android:contentDescription="Grades" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem Bảng Điểm Học Tập"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tra cứu điểm thi các học phần, điểm trung bình CPA/GPA và tiến độ tích lũy"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:paddingTop="2dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnViewGrades"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/hust_red"
                    android:textColor="@color/white"
                    android:text="Tra cứu ▶"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Service 2: In Bảng Điểm -->
            <LinearLayout
                android:id="@+id/cardBtnPrintGrades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_service_item"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:elevation="1dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_print"
                    android:contentDescription="Print" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="In Bảng Điểm Sinh Viên"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="In bảng điểm chính thức kèm chữ ký số xác thực tại máy in Kiosk"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:paddingTop="2dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnPrintGrades"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/hust_red"
                    android:textColor="@color/white"
                    android:text="In ngay ▶"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Service 3: Dịch Vụ Khác -->
            <LinearLayout
                android:id="@+id/cardBtnOtherServices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/card_service_item"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:elevation="1dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_more"
                    android:contentDescription="Other Services" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dịch Vụ Sinh Viên Khác"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xác nhận sinh viên, đăng ký giấy tờ đào tạo, thủ tục vay vốn học tập"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:paddingTop="2dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnOtherServices"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hust_red"
                    android:text="Khám phá ▶"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Primary Large Touch End Session Button -->
            <Button
                android:id="@+id/btnEndSession"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/btn_end_session"
                android:backgroundTint="@null"
                android:text="🚪  KẾT THÚC PHIÊN LÀM VIỆC"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:elevation="2dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
