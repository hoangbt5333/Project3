<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootServicePlaceholder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#121212"
    android:padding="24dp">

    <!-- Service Title -->
    <TextView
        android:id="@+id/tvServiceName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📊 DỊCH VỤ SINH VIÊN"
        android:textColor="#00E676"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <!-- Current Student Info Badge -->
    <TextView
        android:id="@+id/tvStudentInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#222222"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="Sinh viên: --"
        android:textColor="#29B6F6"
        android:textSize="13sp" />

    <!-- Placeholder Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="32dp"
        android:background="#1F1F1F"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚧"
            android:textSize="56sp"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TÍNH NĂNG ĐANG TRONG QUÁ TRÌNH PHÁT TRIỂN"
            android:textColor="#FFB74D"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hệ thống sẽ kết nối với CSDL đào tạo và máy in Kiosk ở các giai đoạn tiếp theo."
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnBackToProfile"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:padding="14dp"
            android:text="◀ Quay lại Trang cá nhân"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnEndSessionService"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="14dp"
            android:text="🚪 Kết thúc phiên"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#D32F2F" />
    </LinearLayout>

</LinearLayout>
