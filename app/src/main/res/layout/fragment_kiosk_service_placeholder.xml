<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootServicePlaceholder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kiosk_bg">

    <!-- Top Header Bar with HUST Branding -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_hust_header"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_hust_emblem"
            android:contentDescription="HUST Emblem" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CỔNG DỊCH VỤ SINH VIÊN"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ĐẠI HỌC BÁCH KHOA HÀ NỘI"
                android:textColor="@color/hust_gold"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnEndSessionService"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="#40FFFFFF"
            android:textColor="@color/white"
            android:text="🚪  Kết thúc phiên"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="24dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="640dp"
            android:background="@drawable/card_white_rounded"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:elevation="2dp">

            <!-- Service Title -->
            <TextView
                android:id="@+id/tvServiceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DỊCH VỤ SINH VIÊN"
                android:textColor="@color/hust_red"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:paddingBottom="8dp" />

            <!-- Current Student Info Badge -->
            <TextView
                android:id="@+id/tvStudentInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_status_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="Sinh viên: --"
                android:textColor="@color/status_info"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Placeholder Notification Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="28dp"
                android:background="@color/kiosk_bg"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚧"
                    android:textSize="52sp"
                    android:paddingBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TÍNH NĂNG ĐANG TRONG QUÁ TRÌNH PHÁT TRIỂN"
                    android:textColor="@color/hust_red_dark"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:paddingBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hệ thống sẽ kết nối với Cơ sở dữ liệu Đào tạo và phần cứng máy in Kiosk ở các giai đoạn tiếp theo."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textAlignment="center"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Back to Profile Button -->
            <Button
                android:id="@+id/btnBackToProfile"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/btn_hust_primary"
                android:backgroundTint="@null"
                android:text="◀  Quay lại Trang cá nhân"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
