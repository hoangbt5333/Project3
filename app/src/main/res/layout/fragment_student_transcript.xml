<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootTranscriptLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kiosk_bg">

    <!-- Top Header Bar with HUST Branding -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_hust_header"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_hust_emblem"
            android:contentDescription="HUST Emblem" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BẢNG ĐIỂM HỌC PHẦN SINH VIÊN"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ĐẠI HỌC BÁCH KHOA HÀ NỘI • CỔNG TRA CỨU ĐIỂM"
                android:textColor="@color/hust_gold"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnEndSessionTop"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="#40FFFFFF"
            android:textColor="@color/white"
            android:text="🚪  Kết thúc phiên"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <!-- Student Information Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_white_rounded"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:gravity="center_vertical"
            android:elevation="1dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_student_avatar"
                android:contentDescription="Student Avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:id="@+id/tvTranscriptStudentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nguyễn Văn An"
                    android:textColor="@color/hust_red"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTranscriptStudentDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MSSV: 20231001  •  Lớp: IT1-01  •  Khoa: Công nghệ Thông tin"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:paddingTop="2dp" />
            </LinearLayout>

            <!-- Credits Summary Badge -->
            <TextView
                android:id="@+id/tvTranscriptCreditsSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_status_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Tích lũy: 21 TC"
                android:textColor="@color/status_info"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Transcript Table Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_table_container"
            android:orientation="vertical"
            android:elevation="2dp">

            <!-- Table Header Row (HUST Deep Red) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_table_header"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Học kỳ"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#40FFFFFF" />

                <TextView
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Mã HP"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#40FFFFFF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="14dp"
                    android:text="Tên học phần"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#40FFFFFF" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="TC"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#40FFFFFF" />

                <TextView
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Điểm học phần"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Table Rows List (RecyclerView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTranscriptList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:scrollbars="vertical" />

            <!-- Empty State Container (when student has no grades) -->
            <LinearLayout
                android:id="@+id/layoutEmptyTranscript"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📂"
                    android:textSize="52sp"
                    android:paddingBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHƯA CÓ DỮ LIỆU BẢNG ĐIỂM HỌC PHẦN"
                    android:textColor="@color/hust_red_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sinh viên này hiện chưa có dữ liệu điểm học phần trong hệ thống đào tạo.\n(Trường hợp kiểm thử giao diện rỗng theo yêu cầu kỹ thuật)"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textAlignment="center"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Disclaimer Note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="* Dữ liệu điểm học phần trên là dữ liệu giả lập phục vụ thử nghiệm giao diện Smart Kiosk ĐHBK Hà Nội. Không phải văn bản chứng nhận kết quả chính thức."
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp" />

    </LinearLayout>

    <!-- Bottom Actions Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:background="@color/white"
        android:elevation="4dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnBackToProfile"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:background="@drawable/btn_hust_primary"
            android:backgroundTint="@null"
            android:text="◀  Quay lại Trang cá nhân"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEndSessionBottom"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:paddingHorizontal="20dp"
            android:background="@drawable/btn_end_session"
            android:backgroundTint="@null"
            android:text="🚪  Kết thúc phiên"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
