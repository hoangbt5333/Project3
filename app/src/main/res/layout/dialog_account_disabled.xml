<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/card_white_rounded"
    android:gravity="center_horizontal">

    <!-- Top Alert Icon with soft red circle background -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/badge_status_bg"
        android:backgroundTint="@color/status_error_bg"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_alert"
            app:tint="@color/status_error"
            android:contentDescription="Alert Icon" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TÀI KHOẢN BỊ VÔ HIỆU HÓA"
        android:textColor="@color/status_error"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:textAlignment="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hệ thống Kiosk tạm dừng quyền truy cập của tài khoản này"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:paddingTop="4dp"
        android:paddingBottom="14dp"
        android:textAlignment="center" />

    <!-- Info Box: Account details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F8FAFC"
        android:padding="14dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tvDisabledStudentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nguyễn Văn A"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvDisabledStudentId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mã tài khoản: 20200001"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:paddingBottom="2dp" />

        <TextView
            android:id="@+id/tvDisabledStudentClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lớp: CNTT 01 - K65 • Khoa: Viện CNTT &amp; TT"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvDisabledStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FFEBEE"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="TRẠNG THÁI: ĐÃ BỊ KHÓA"
            android:textColor="@color/status_error"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Detailed Guidance Message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ Vui lòng liên hệ Văn phòng Quản lý Đào tạo hoặc Quản trị viên Kiosk để kiểm tra lý do và mở khóa tài khoản trước khi tiếp tục."
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:paddingBottom="18dp"
        android:textAlignment="center" />

    <!-- Big Confirmation / Resume Button -->
    <Button
        android:id="@+id/btnConfirmDisabledAccount"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/btn_hust_primary"
        android:text="Xác nhận &amp; Mở lại camera"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
